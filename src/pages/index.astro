---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Philosophy from "../components/Philosophy.astro";
import Services from "../components/Services.astro";
import DoctorIntro from "../components/DoctorIntro.astro";
import ContactCta from "../components/ContactCta.astro";
import CineNav from "../components/CineNav.astro";
import TrustBar from "../components/TrustBar.astro";
import JournalPreview from "../components/JournalPreview.astro";
import Footer from "../components/Footer.astro";
---
<Layout
  title="Zahnarzt in Nottuln | Dr. Ashraf Hanafi – HB+ Zahnärzte"
  description="Lokaler Zahnarzt in Nottuln im Münsterland: Dr. Ashraf Hanafi im Kreis Coesfeld, NRW. Zahnmedizin, Prophylaxe und ästhetische Zahnheilkunde."
  path="/"
>
  <Header />
  <CineNav />
  <main id="main">
    <div class="scene-wrapper">
      <Hero />
      <Philosophy />
      <Services />
      <DoctorIntro />
      <ContactCta />
    </div>
    <TrustBar />
    <JournalPreview />
  </main>
  <Footer />
</Layout>

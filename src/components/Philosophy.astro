---
---
<section class="scene philosophy-scene" id="scene-philosophy">
  <div class="scene-scrim philosophy-scrim"></div>
  <div class="scene-content philosophy-content">
    <p class="tag" style="--stagger:0">Unsere Haltung</p>
    <blockquote style="--stagger:1">Zuhören ist der Anfang<br /><em>jeder guten Behandlung.</em></blockquote>
  </div>
</section>

<style>
  .philosophy-scene { align-items: center; text-align: left; background: var(--teal-deep); }
  .philosophy-scrim {
    background: radial-gradient(60% 60% at 30% 30%, rgba(244,239,228,0.06), transparent 70%);
  }
  .philosophy-content { max-width: 1100px; }
  .tag {
    font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase;
    color: rgba(244,239,228,0.6); margin: 0 0 26px;
  }
  blockquote {
    font-family: var(--font-serif);
    font-weight: 340;
    font-style: italic;
    font-size: clamp(32px, 6vw, 76px);
    line-height: 1.1;
    margin: 0;
    color: var(--sand);
  }
  blockquote em { font-weight: 560; color: var(--terracotta); font-style: italic; }
</style>

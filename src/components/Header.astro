---
const nav = [
  { href: "/praxis", label: "Praxis" },
  { href: "/leistungen", label: "Leistungen" },
  { href: "/praxis#team", label: "Team" },
  { href: "/journal", label: "Aktuelles" },
];
---
<header class="site-header">
  <a class="logo" href="/">HB+</a>
  <nav aria-label="Hauptnavigation">
    {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    <a class="call-pill" href="tel:+49250225061">02502 25061</a>
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22px var(--gutter);
  }
  .logo {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 20px;
    color: var(--teal-deep);
    text-decoration: none;
  }
  nav { display: flex; align-items: center; }
  nav a {
    text-decoration: none;
    color: var(--ink);
    font-size: 14px;
    margin-left: 28px;
    opacity: 0.75;
  }
  nav a:hover { opacity: 1; }
  .call-pill {
    border: 1px solid var(--teal-deep);
    border-radius: 999px;
    padding: 9px 18px;
    font-size: 13px;
    color: var(--teal-deep) !important;
    opacity: 1 !important;
  }
  @media (max-width: 720px) {
    nav a:not(.call-pill) { display: none; }
  }
</style>

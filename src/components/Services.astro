---
---
<!-- 01 — Vorsorge & Prophylaxe: helle Szene, Zahl bricht aus dem oberen Rand -->
<section class="scene svc svc-1" id="scene-service-01">
  <span class="svc-num svc-num--crop parallax-slow" aria-hidden="true">01</span>
  <div class="scene-content svc-content">
    <svg class="line-icon" viewBox="0 0 200 120" width="64" height="40" style="--stagger:0">
      <path d="M20,100 A80,80 0 0,1 180,100" />
      <path d="M45,100 A55,55 0 0,1 155,100" />
      <path d="M70,100 A30,30 0 0,1 130,100" />
    </svg>
    <p class="svc-eyebrow" style="--stagger:1">Leistung 01 / 05</p>
    <h2 style="--stagger:2">Vorsorge &amp;<br />Prophylaxe</h2>
    <p class="svc-text" style="--stagger:3">Gesund erhalten statt reparieren — mit regelmäßiger Kontrolle und professioneller Zahnreinigung.</p>
    <a class="text-link" style="--stagger:4" href="/leistungen/prophylaxe">Mehr erfahren →</a>
  </div>
</section>

<!-- 02 — Zahnerhalt: dunkle Umkehr-Szene, rechtsbündig, ruhiger Kontrast -->
<section class="scene svc svc-2" id="scene-service-02">
  <div class="scene-content svc-content svc-content--right">
    <svg class="line-icon" viewBox="0 0 200 200" width="56" height="56" style="--stagger:0">
      <path d="M100,20 L100,120" />
      <path d="M100,120 C80,120 70,145 78,168 C86,190 114,190 122,168 C130,145 120,120 100,120 Z" />
    </svg>
    <p class="svc-eyebrow" style="--stagger:1">Leistung 02 / 05</p>
    <h2 style="--stagger:2">Zahnerhalt</h2>
    <p class="svc-text" style="--stagger:3">Schonende Füllungen und Wurzelbehandlungen mit dem Ziel, den eigenen Zahn zu bewahren.</p>
    <a class="text-link" style="--stagger:4" href="/leistungen/zahnerhalt">Mehr erfahren →</a>
  </div>
  <span class="svc-num svc-num--faint" aria-hidden="true">02</span>
</section>

<!-- 03 — Zahnersatz: Split-Screen, Headline auf der Naht -->
<section class="scene svc svc-3" id="scene-service-03">
  <div class="svc-split-left parallax-x" aria-hidden="true"></div>
  <div class="svc-split-right parallax-x" aria-hidden="true"></div>
  <div class="scene-content svc-content svc-content--center">
    <svg class="line-icon" viewBox="0 0 200 120" width="72" height="44" style="--stagger:0">
      <circle cx="85" cy="60" r="45" />
      <circle cx="125" cy="60" r="45" />
    </svg>
    <p class="svc-eyebrow" style="--stagger:1">Leistung 03 / 05</p>
    <h2 style="--stagger:2">Zahnersatz</h2>
    <p class="svc-text" style="--stagger:3">Passgenaue, ästhetische Lösungen für zuverlässige Funktion im Alltag.</p>
    <a class="text-link" style="--stagger:4" href="/leistungen/zahnersatz">Mehr erfahren →</a>
  </div>
</section>

<!-- 04 — Ästhetische Zahnmedizin: Foto-Panel rechts, Text links -->
<section class="scene svc svc-4" id="scene-service-04">
  <div class="svc-photo-panel" aria-hidden="true">
    <div class="media-fill svc-photo-tint parallax-slow"></div>
    <span class="placeholder-badge placeholder-badge--inline">Fotografie folgt</span>
  </div>
  <div class="scene-content svc-content svc-content--narrow">
    <svg class="line-icon" viewBox="0 0 200 100" width="70" height="35" style="--stagger:0">
      <path d="M20,30 A80,70 0 0,0 180,30" />
      <circle cx="165" cy="18" r="3" fill="currentColor" stroke="none" />
    </svg>
    <p class="svc-eyebrow" style="--stagger:1">Leistung 04 / 05</p>
    <h2 style="--stagger:2">Ästhetische<br />Zahnmedizin</h2>
    <p class="svc-text" style="--stagger:3">Natürlich schöne Zähne, behutsam und ohne Übertreibung behandelt.</p>
    <a class="text-link" style="--stagger:4" href="/leistungen/aesthetik">Mehr erfahren →</a>
  </div>
</section>

<!-- 05 — Kinderzahnmedizin: diagonaler Farbschnitt, gedrehte Zahl -->
<section class="scene svc svc-5" id="scene-service-05">
  <div class="svc-diagonal" aria-hidden="true"></div>
  <span class="svc-num svc-num--tilt parallax-slow" aria-hidden="true">05</span>
  <div class="scene-content svc-content">
    <svg class="line-icon" viewBox="0 0 200 120" width="60" height="36" style="--stagger:0">
      <path d="M30,90 A70,70 0 0,1 170,90" />
      <circle cx="170" cy="60" r="4" fill="currentColor" stroke="none" />
    </svg>
    <p class="svc-eyebrow" style="--stagger:1">Leistung 05 / 05</p>
    <h2 style="--stagger:2">Kinderzahn-<br />medizin</h2>
    <p class="svc-text" style="--stagger:3">Ein ruhiger, spielerischer Einstieg in eine lebenslange Zahngesundheit.</p>
    <a class="text-link" style="--stagger:4" href="/leistungen/kinderzahnmedizin">Mehr erfahren →</a>
  </div>
</section>
sleep 0.1
<style>
  .svc-eyebrow {
    font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--terracotta); margin: 18px 0 22px;
  }
  .svc-content h2 {
    font-family: var(--font-serif); font-weight: 500;
    font-size: clamp(34px, 5.5vw, 64px); margin: 0 0 24px; line-height: 1.04;
  }
  .svc-text { font-size: clamp(16px, 1.6vw, 19px); line-height: 1.6; max-width: 42ch; margin: 0 0 28px; }
  .text-link { text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 2px; }

  .svc-1 { align-items: center; background: var(--sand); }
  .svc-num--crop {
    position: absolute; top: -6vw; left: var(--gutter);
    font-family: var(--font-serif); font-size: clamp(140px, 26vw, 380px);
    color: var(--sand-deep); line-height: 1; z-index: 0; pointer-events: none;
  }
  .svc-1 .svc-content { max-width: 640px; }
  .svc-1 h2, .svc-1 .line-icon { color: var(--teal-deep); }

  .svc-2 { align-items: center; justify-content: center; background: var(--teal-deep); color: var(--sand); }
  .svc-content--right { max-width: 560px; margin-left: auto; text-align: right; }
  .svc-content--right .svc-eyebrow { color: var(--terracotta); }
  .svc-2 h2 { color: var(--sand); }
  .svc-2 .svc-text { color: rgba(244,239,228,0.78); margin-left: auto; }
  .svc-2 .text-link { color: var(--sand); }
  .svc-content--right .line-icon { margin-left: auto; color: rgba(244,239,228,0.7); }
  .svc-num--faint {
    position: absolute; left: var(--gutter); bottom: 26px;
    font-family: var(--font-serif); font-size: clamp(60px, 8vw, 120px);
    color: rgba(244,239,228,0.12); line-height: 1;
  }

  .svc-3 { align-items: center; justify-content: center; background: var(--sand); }
  .svc-split-left, .svc-split-right {
    position: absolute; top: 0; bottom: 0; width: 52%; z-index: 0;
  }
  .svc-split-left { left: 0; background: var(--teal-deep); }
  .svc-split-right { right: 0; background: var(--sand-deep); }
  .svc-content--center { position: relative; z-index: 1; text-align: center; max-width: 620px; }
  .svc-content--center .line-icon { margin: 0 auto; color: var(--terracotta); }
  .svc-content--center .svc-eyebrow { color: var(--sand); }
  .svc-3 h2 {
    color: var(--sand);
    background: linear-gradient(90deg, var(--sand) 0%, var(--sand) 50%, var(--teal-deep) 50%, var(--teal-deep) 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .svc-content--center .svc-text { color: var(--ink); max-width: 40ch; margin-left: auto; margin-right: auto; }
  .svc-content--center .text-link { color: var(--teal-deep); }

  .svc-4 { align-items: center; background: var(--sand); }
  .svc-photo-panel {
    position: absolute; top: 0; right: 0; bottom: 0; width: 42%;
    overflow: hidden; z-index: 0;
  }
  .svc-photo-tint {
    background: linear-gradient(160deg, var(--sand-deep), var(--line));
    opacity: 1 !important; transform: none !important;
  }
  .placeholder-badge--inline { bottom: 20px; right: 20px; }
  .svc-content--narrow { max-width: 480px; position: relative; z-index: 1; }
  .svc-4 h2, .svc-4 .line-icon { color: var(--teal-deep); }

  .svc-5 { align-items: center; background: var(--sand); }
  .svc-diagonal {
    position: absolute; inset: -10% -10%; z-index: 0;
    background: var(--terracotta);
    opacity: 0.12;
    clip-path: polygon(0 62%, 100% 38%, 100% 100%, 0% 100%);
  }
  .svc-num--tilt {
    position: absolute; right: 4vw; bottom: -4vw;
    font-family: var(--font-serif); font-size: clamp(120px, 20vw, 300px);
    color: var(--sand-deep); line-height: 1; z-index: 0;
    transform: rotate(-8deg);
  }
  .svc-5 .scene-content { position: relative; z-index: 1; max-width: 620px; }
  .svc-5 h2, .svc-5 .line-icon { color: var(--teal-deep); }

  @media (max-width: 780px) {
    .svc-split-left, .svc-split-right { width: 100%; }
    .svc-split-right { display: none; }
    .svc-photo-panel { position: relative; width: 100%; height: 220px; margin-bottom: 24px; inset: auto; }
    .svc-content--right { margin-left: 0; text-align: left; }
    .svc-content--right .svc-text, .svc-content--right .line-icon { margin-left: 0; }
    .svc-num--crop, .svc-num--tilt, .svc-num--faint { display: none; }
  }
</style>

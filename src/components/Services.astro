---
const services = [
  { num: "01", title: "Vorsorge & Prophylaxe", text: "Gesund erhalten statt reparieren — mit regelmäßiger Kontrolle.", href: "/leistungen/prophylaxe" },
  { num: "02", title: "Zahnerhalt", text: "Schonende Füllungen und Wurzelbehandlungen.", href: "/leistungen/zahnerhalt" },
  { num: "03", title: "Zahnersatz", text: "Ästhetische, funktionale Lösungen für Ihren Alltag.", href: "/leistungen/zahnersatz" },
  { num: "04", title: "Ästhetik", text: "Natürlich schöne Zähne, behutsam behandelt.", href: "/leistungen/aesthetik" },
  { num: "05", title: "Kinderzahnmedizin", text: "Einfühlsam und spielerisch für gesunde Kinderzähne.", href: "/leistungen/kinderzahnmedizin" },
];
---
<section class="services" id="leistungen">
  <h2>Was wir für Sie tun</h2>
  <div class="card-grid">
    {services.map((s) => (
      <a class="card" href={s.href}>
        <span class="num">{s.num}</span>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
      </a>
    ))}
  </div>
</section>

<style>
  .services { padding: 0 var(--gutter) 140px; max-width: var(--container); margin: 0 auto; }
  .services h2 {
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--teal);
    margin-bottom: 40px;
    font-weight: 500;
  }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .card {
    background: var(--sand);
    padding: 34px 28px;
    transition: background 0.3s ease;
    text-decoration: none;
    color: var(--ink);
    display: block;
  }
  .card:hover { background: var(--sand-deep); }
  .card .num {
    font-family: var(--font-serif);
    font-size: 14px;
    color: var(--terracotta);
    margin-bottom: 22px;
    display: block;
  }
  .card h3 { font-family: var(--font-serif); font-weight: 500; font-size: 22px; margin: 0 0 10px; }
  .card p { font-size: 14px; line-height: 1.55; opacity: 0.75; margin: 0; }
</style>

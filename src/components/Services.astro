---
const services = [
  { num: "01", title: "Vorsorge & Prophylaxe", text: "Gesund erhalten statt reparieren — mit regelmäßiger Kontrolle und professioneller Zahnreinigung.", href: "/leistungen/prophylaxe" },
  { num: "02", title: "Zahnerhalt", text: "Schonende Füllungen und Wurzelbehandlungen mit dem Ziel, den eigenen Zahn zu bewahren.", href: "/leistungen/zahnerhalt" },
  { num: "03", title: "Zahnersatz", text: "Passgenaue, ästhetische Lösungen für zuverlässige Funktion im Alltag.", href: "/leistungen/zahnersatz" },
  { num: "04", title: "Ästhetische Zahnmedizin", text: "Natürlich schöne Zähne, behutsam und ohne Übertreibung behandelt.", href: "/leistungen/aesthetik" },
  { num: "05", title: "Kinderzahnmedizin", text: "Ein ruhiger, spielerischer Einstieg in eine lebenslange Zahngesundheit.", href: "/leistungen/kinderzahnmedizin" },
];
---
{services.map((s, i) => (
  <section class="scene service-scene" id={`scene-service-${s.num}`}>
    <div class="scene-bg"><div class="media-fill service-tint"></div></div>
    <div class="scene-content service-content">
      <p class="service-eyebrow" style="--stagger:0">Leistung {s.num} / 05</p>
      <h2 style="--stagger:1">{s.title}</h2>
      <p class="service-text" style="--stagger:2">{s.text}</p>
      <a class="text-link" style="--stagger:3" href={s.href}>Mehr erfahren →</a>
    </div>
    <span class="service-num" aria-hidden="true">{s.num}</span>
  </section>
))}

<style>
  .service-scene { align-items: center; }
  .service-tint { background: var(--sand-deep); opacity: 1 !important; transform: none !important; }
  .service-content { max-width: 720px; }
  .service-eyebrow {
    font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--terracotta); margin: 0 0 22px;
  }
  .service-content h2 {
    font-family: var(--font-serif); font-weight: 500;
    font-size: clamp(34px, 5.5vw, 64px); margin: 0 0 24px; color: var(--teal-deep);
  }
  .service-text { font-size: clamp(16px, 1.6vw, 19px); line-height: 1.6; max-width: 46ch; margin: 0 0 28px; }
  .text-link { text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 2px; }
  .service-num {
    position: absolute;
    right: var(--gutter);
    bottom: 30px;
    z-index: 1;
    font-family: var(--font-serif);
    font-size: clamp(80px, 14vw, 220px);
    color: var(--line);
    line-height: 1;
    pointer-events: none;
  }
</style>

---
---
<section class="scene doctor-scene" id="scene-doctor">
  <div class="scene-bg"><div class="media-fill doctor-tint"></div></div>
  <div class="scene-scrim doctor-scrim"></div>
  <div class="placeholder-badge">Porträtfoto folgt</div>
  <div class="scene-content doctor-content">
    <p class="eyebrow" style="--stagger:0">Ihr Zahnarzt</p>
    <h2 style="--stagger:1">Dr. med. dent.<br /><em>Ashraf Hanafi</em></h2>
    <blockquote style="--stagger:2">„Mir ist wichtig, dass Sie sich gut informiert und jederzeit sicher fühlen.“</blockquote>
    <a class="text-link" style="--stagger:3" href="/praxis">Praxis &amp; Team kennenlernen →</a>
  </div>
</section>

<style>
  .doctor-scene { align-items: flex-end; background: var(--ink); }
  .doctor-tint {
    background: linear-gradient(140deg, rgba(22,91,91,0.9), rgba(29,38,36,0.98));
    opacity: 1 !important; transform: none !important;
  }
  .doctor-scrim { background: linear-gradient(0deg, rgba(0,0,0,0.35), transparent 55%); }
  .doctor-content { max-width: 640px; padding-bottom: 90px; color: var(--sand); }
  .eyebrow { font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--terracotta); margin: 0 0 18px; }
  .doctor-content h2 {
    font-family: var(--font-serif); font-weight: 340; font-size: clamp(32px, 5vw, 58px);
    line-height: 1.08; margin: 0 0 26px; color: var(--sand);
  }
  .doctor-content h2 em { font-style: italic; font-weight: 560; }
  .doctor-content blockquote {
    font-family: var(--font-serif); font-style: italic; font-size: clamp(18px, 2vw, 22px);
    margin: 0 0 26px; color: rgba(244,239,228,0.85);
  }
  .doctor-content .text-link { color: var(--sand); text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 2px; }
</style>

<section class="scene contact-scene" id="scene-contact">
  <div class="scene-bg"><div class="mesh-bg mesh-bg--light parallax-fast"></div></div>
  <div class="grain"></div>
  <div class="scene-content contact-content">
    <p class="eyebrow" style="--stagger:0">Wir sind für Sie da</p>
    <h2 style="--stagger:1">Ihr Termin beginnt<br /><em>mit einem Anruf.</em></h2>
    <a class="btn btn-primary" style="--stagger:2" href="tel:+49250225061">02502 25061 →</a>
  </div>
</section>

<style>
  .contact-scene { align-items: center; }
  .contact-content { max-width: 720px; }
  .eyebrow { font-size: 13.5px; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 600; color: var(--signal); margin: 0 0 20px; }
  .contact-content h2 {
    font-weight: 660; font-size: clamp(36px, 6vw, 72px);
    line-height: 1.04; margin: 0 0 40px; color: var(--ink);
  }
  .contact-content h2 em { font-style: italic; font-weight: 800; color: var(--signal-deep); }
  .btn-primary {
    background: var(--ink); color: var(--paper); text-decoration: none;
    padding: 18px 34px; border-radius: 999px; font-size: 16px; font-weight: 600;
    display: inline-flex; transition: transform 0.3s var(--ease-out), background 0.3s ease, box-shadow 0.3s ease;
  }
  .btn-primary:hover { transform: translateY(-3px) scale(1.02); background: var(--signal-deep); box-shadow: 0 14px 30px rgba(10,89,67,0.25); }
</style>

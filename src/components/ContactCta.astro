---
<section class="scene contact-scene" id="scene-contact">
  <div class="scene-bg"><div class="media-fill aurora contact-aurora"></div></div>
  <div class="scene-content contact-content">
    <p class="eyebrow" style="--stagger:0">Wir sind für Sie da</p>
    <h2 style="--stagger:1">Ihr Termin beginnt<br /><em>mit einem Anruf.</em></h2>
    <a class="btn btn-primary" style="--stagger:2" href="tel:+49250225061">02502 25061 →</a>
  </div>
</section>

<style>
  .contact-scene { align-items: center; }
  .contact-aurora { filter: blur(10px) brightness(1.08); }
  .contact-content { max-width: 720px; }
  .eyebrow { font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--teal); margin: 0 0 20px; }
  .contact-content h2 {
    font-family: var(--font-serif); font-weight: 340; font-size: clamp(36px, 6vw, 72px);
    line-height: 1.04; margin: 0 0 40px; color: var(--teal-deep);
  }
  .contact-content h2 em { font-style: italic; font-weight: 560; }
  .btn-primary {
    background: var(--teal-deep); color: var(--sand); text-decoration: none;
    padding: 17px 32px; border-radius: 999px; font-size: 16px; font-weight: 500;
    display: inline-flex; transition: transform 0.25s ease, background 0.25s ease;
  }
  .btn-primary:hover { transform: translateY(-2px); background: var(--teal); }
</style>
